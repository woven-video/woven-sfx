---
import { homepageFaqs } from "../lib/seo/faqs";
---

<section
  id="faq"
  class="mx-auto max-w-6xl px-6 py-8 md:py-10"
  aria-labelledby="faq-heading"
>
  <h2
    id="faq-heading"
    class="text-2xl font-semibold tracking-[-0.025em] leading-[1.05] md:text-3xl"
  >
    Frequently asked questions
  </h2>
  <dl class="mt-5 max-w-3xl space-y-5">
    {
      homepageFaqs.map((faq) => (
        <div>
          <dt class="text-base font-medium text-foreground">{faq.q}</dt>
          <dd class="mt-1 text-base leading-[1.5] text-muted-foreground">
            {faq.a}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
